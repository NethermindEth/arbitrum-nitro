# Sepolia L1 RPC API Key
# Get your API key from the RPC provider
SEPOLIA_RPC_API_KEY=your_api_key_here

# Fallback RPC endpoints (optional)
# Comma-separated list of public RPC endpoints to use as fallback when primary connection fails
# These will be tried in order only if the primary RPC endpoint is unavailable
# Leave empty or unset to disable fallback mechanism
NITRO_PARENT_CHAIN_FALLBACK_URLS=https://0xrpc.io/sep,https://rpc.sepolia.org,https://rpc2.sepolia.org,https://ethereum-sepolia-rpc.publicnode.com

# Additional public Sepolia RPC endpoints you can use:
# - https://rpc.ankr.com/eth_sepolia
# - https://ethereum-sepolia.blockpi.network/v1/rpc/public
# - https://eth-sepolia.g.alchemy.com/v2/demo (rate limited)
# - https://sepolia.infura.io/v3/YOUR_INFURA_KEY

# Note: Public RPCs may have rate limits and privacy concerns
# Use your own private RPC endpoint whenever possible
